<!-- ============================================================
     Decodeur personnalise Wazuh - TFE Eurostar
     Issue #22 - Sprint 4 (Iteration 2, partie 2)

     Objectif : peupler le champ statique srcip pour les evenements
     Suricata (decodeur json generique), qui ne le fait pas par
     defaut (seuls les champs dynamiques comme src_ip sont extraits).

     IMPORTANT - decodeur "sibling" (meme nom que le parent "json"),
     et non un enfant a nom distinct. Premiere tentative avec un nom
     distinct ("suricata-json-srcip") invalidee empiriquement le
     23/07/2026 : Wazuh arrete la recherche des qu'un decodeur enfant
     correspond et n'utilise QUE son extraction, remplacant celle du
     parent (confirme par wazuh-logtest : alert.signature_id et tous
     les autres champs dynamiques avaient disparu). Les decodeurs
     "sibling" (meme nom litteral que leur parent) sont le mecanisme
     documente pour fusionner plusieurs extractions au lieu de les
     remplacer.
     Reference : Wazuh Documentation - Sibling Decoders
     https://documentation.wazuh.com/current/user-manual/ruleset/decoders/sibling-decoders.html
     ============================================================ -->

<decoder name="json">
  <parent>json</parent>
  <regex>"src_ip":"(\d+.\d+.\d+.\d+)"</regex>
  <order>srcip</order>
</decoder>
