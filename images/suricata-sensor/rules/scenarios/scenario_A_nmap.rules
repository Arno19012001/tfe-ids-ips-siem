# ============================================================
# Scénario A — Reconnaissance réseau (Nmap) | Kill chain : T1595.001, T1046
# SID 1000100-1000199 | Mode : alert-only (A4/blocage géré par Wazuh AR)
# Cible : $DMZ_NET (10.0.10.0/24) — segment traversant le pont Suricata
# SID 1000102-1000103 (OS fingerprinting) retirées : normalisées par pfSense
# avant d'atteindre le capteur, hors périmètre des critères A1-A4 (Issue #37)
# ============================================================

# Détecte un balayage SYN (nmap -sS) : seuil 15 paquets SYN/10s par source.
# A4 (IP bloquée après seuil) implémenté côté Wazuh active-response (rule
# 100050 -> firewall-drop sur suricata-sensor), pas ici : le mot-clé
# threshold de Suricata ne limite que la fréquence de log des alertes, pas
# les effets de bord (xbits/drop), donc un blocage fiable "après N matches"
# n'est pas réalisable nativement dans une règle Suricata (cf. rapport).
alert tcp $EXTERNAL_NET any -> $DMZ_NET any (msg:"SCENARIO_A Nmap SYN Scan Detected"; flow:stateless; flags:S,12; threshold:type both, track by_src, count 15, seconds 10; classtype:attempted-recon; metadata: scenario A, mitre_tactic TA0007_Discovery, mitre_technique T1046; reference:url,attack.mitre.org/techniques/T1046/; sid:1000101; rev:7;)

# Détecte une sonde de détection de service/version (nmap -sV), 1 hit par
# paire source/destination. Limitation connue : faux positifs possibles sur
# trafic HTTP/SSH légitime en volume ; non requis par A1-A4 (SID 1000101
# uniquement), conservée pour la couverture -sV.
alert tcp $EXTERNAL_NET any -> $DMZ_NET any (msg:"SCENARIO_A Nmap Service/Version Detection Probe"; flow:to_server,established; threshold:type both, track by_both, count 1, seconds 10; classtype:attempted-recon; metadata: scenario A, mitre_tactic TA0007_Discovery, mitre_technique T1046; reference:url,attack.mitre.org/techniques/T1046/; sid:1000104; rev:4;)
