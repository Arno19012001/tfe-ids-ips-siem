# ============================================================
# Scénario A — Reconnaissance réseau (Nmap)
# TFE Eurostar — Kill chain : TA0043/T1595.001, TA0007/T1046
# Commande de référence : nmap -sS -A -p 1-1000 192.168.1.0/24
# Plage SID réservée : 1000100-1000199
# Mode : alert-only (validation IDS, aucun blocage à ce stade)
# Cible : $DMZ_NET (10.0.10.0/24) — seul segment traversant
# effectivement le pont inline Suricata (eth0<->eth1)
#
# NB : chaque règle DOIT tenir sur une seule ligne physique
# (correction suite au crash du 2026-07-04 : "Signature missing
# required value sid" causé par des règles multi-lignes sans
# continuation "\").
# ============================================================

# --- Signature 1 : détection de balayage SYN (-sS) ---
alert tcp $EXTERNAL_NET any -> $DMZ_NET any (msg:"SCENARIO_A Nmap SYN Scan Detected"; flow:stateless; flags:S,12; threshold:type both, track by_src, count 15, seconds 10; classtype:attempted-recon; metadata: scenario A, mitre_tactic TA0007_Discovery, mitre_technique T1046; reference:url,attack.mitre.org/techniques/T1046/; sid:1000101; rev:1;)

# --- Signature 2 : détection d'empreinte OS (-O, inclus dans -A) — sonde T2 (Null flags) ---
alert tcp $EXTERNAL_NET any -> $DMZ_NET any (msg:"SCENARIO_A Nmap OS Fingerprint Probe - Null Flags (T2)"; flags:0; classtype:attempted-recon; metadata: scenario A, mitre_tactic TA0007_Discovery, mitre_technique T1046; reference:url,attack.mitre.org/techniques/T1046/; sid:1000102; rev:1;)

# --- Signature 2 (suite) : sondes T3/T7 (FIN+PSH+URG) ---
alert tcp $EXTERNAL_NET any -> $DMZ_NET any (msg:"SCENARIO_A Nmap OS Fingerprint Probe - FIN/PSH/URG (T3-T7)"; flags:FPU; classtype:attempted-recon; metadata: scenario A, mitre_tactic TA0007_Discovery, mitre_technique T1046; reference:url,attack.mitre.org/techniques/T1046/; sid:1000103; rev:1;)

# --- Signature 3 : détection de la détection de service/version (-sV) ---
alert tcp $EXTERNAL_NET any -> $DMZ_NET any (msg:"SCENARIO_A Nmap Service/Version Detection Probe"; flow:to_server,established; threshold:type both, track by_src, count 3, seconds 10; classtype:attempted-recon; metadata: scenario A, mitre_tactic TA0007_Discovery, mitre_technique T1046; reference:url,attack.mitre.org/techniques/T1046/; sid:1000104; rev:1;)
