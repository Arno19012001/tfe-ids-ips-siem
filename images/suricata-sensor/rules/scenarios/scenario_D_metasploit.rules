alert ftp $EXTERNAL_NET any -> $DMZ_NET 21 (msg:"SCENARIO_D VSFTPD 2.3.4 Backdoor Trigger - Smiley in Username (CVE-2011-2523)"; flow:to_server,established; ftp.command; content:"USER"; ftp.command_data; content:":)"; classtype:trojan-activity; metadata: scenario D, mitre_tactic TA0001_InitialAccess, mitre_technique T1190; reference:url,attack.mitre.org/techniques/T1190/; reference:cve,2011-2523; sid:1000401; rev:1;)

alert ftp $DMZ_NET 21 -> $EXTERNAL_NET any (msg:"SCENARIO_D VSFTPD Privilege Separation Crash - Backdoor Trigger Side-Effect"; flow:to_client,established; content:"500 OOPS: priv_sock_get_result"; classtype:trojan-activity; metadata: scenario D, mitre_tactic TA0001_InitialAccess, mitre_technique T1190; reference:url,attack.mitre.org/techniques/T1190/; reference:cve,2011-2523; sid:1000402; rev:1;)
