# ============================================================
# Scenario B -- Brute force SSH (Hydra)
# Kill chain : TA0006/T1110.001 (Brute Force: Password Guessing)
# Plage SID reservee : 1000200-1000299
#
# SSH chiffre l'authentification : Suricata ne peut detecter que le volume
# anormal de connexions (proxy indirect d'un brute force), pas la reussite.
# La correlation echec->succes releve du HIDS (Wazuh, regle 40112/100051).
#
# SID 1000201 : seuil calibre empiriquement (attack.sh -t 4, 6 rafales de
# 4-5 connexions/~17s d'ecart) -> count 4/seconds 15, 6/6 rafales detectees.
# Limite : specifique a -t 4 ; un brute force plus lent produirait des
# rafales plus petites potentiellement non detectees.
# ============================================================

alert tcp $EXTERNAL_NET any -> $DMZ_NET $SSH_PORTS (msg:"SCENARIO_B SSH Brute Force - High Connection Rate"; flow:to_server; flags:S; threshold:type both, track by_src, count 4, seconds 15; classtype:attempted-recon; metadata: scenario B, mitre_tactic TA0006_CredentialAccess, mitre_technique T1110.001; reference:url,attack.mitre.org/techniques/T1110/001/; sid:1000201; rev:2;)
