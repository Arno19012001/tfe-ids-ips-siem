# Agentic AI (octopus237/Agentic-AI, adapté) — TFE IDS/IPS & SIEM
# Approche exploratoire/parallèle à killchain_reconstruction.py (it3), qui
# reste le livrable déterministe validé de l'Issue #27. Voir le docstring de
# killchain_reconstruction.py pour le contexte des échecs empiriques du
# 09/08/2026 ayant motivé cette architecture parallèle plutôt qu'un
# remplacement.

# -- Wazuh Server API (auth par token, port 55000) --
# Nécessaire UNIQUEMENT pour les outils list_agents et get_inventory.
# Les 7 autres outils (search_alerts, aggregate_alerts, get_agent_timeline,
# get_rule_frequency, find_entity_across_agents, get_vulnerabilities,
# get_active_agents) passent uniquement par l'indexer ci-dessous et
# fonctionnent sans ce compte.
WAZUH_HOST=https://10.0.30.10:55000
WAZUH_USER=wazuh_agentic
WAZUH_PASS=<A_COMPLETER>
WAZUH_SSL=false

# -- Wazuh Indexer (auth basique, port 9200) --
INDEXER_HOST=https://10.0.30.10:9200
INDEXER_USER=admin
INDEXER_PASS=admin

# -- Ollama (même conteneur ai-agent, donc localhost) --
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# -- Réglages optionnels --
AGENTIC_MAX_STEPS=18
UI_HOST=0.0.0.0
UI_PORT=5000
